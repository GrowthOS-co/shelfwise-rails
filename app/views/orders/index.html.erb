<% content_for :title, "Orders · Shelfwise" %>

<h1>Orders</h1>

<% if @orders.empty? %>
  <p class="muted">No orders yet.</p>
<% else %>
  <table class="table">
    <thead>
      <tr>
        <th>Order</th>
        <th>Placed</th>
        <th>Customer</th>
        <th class="numeric">Books</th>
        <th class="numeric">Total</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td><%= link_to order.number, order, class: "strong-link" %></td>
          <td><%= short_date(order.created_at) %></td>
          <td><%= order.customer_name %></td>
          <td class="numeric"><%= order.book_count %></td>
          <td class="numeric"><%= money(order.total_cents) %></td>
          <td><%= status_badge(order.status) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
